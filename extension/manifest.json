{
    "manifest_version": 3,
    "name": "nextStep",
    "version": "1.0",
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["http://localhost/*"],
        "js": ["bridge.js"]
      }
    ],
    "permissions": ["tabs", "scripting"],
    "host_permissions": [
      "https://www.youtube.com/*"
    ]
  }
  